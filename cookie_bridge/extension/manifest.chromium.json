{
  "manifest_version": 3,
  "name": "Gemini Cookie Bridge",
  "version": "1.0.0",
  "description": "Keeps a local Gemini MCP server signed in by handing this browser's Google session cookies to it on this computer (native messaging). Nothing is sent over the network.",
  "permissions": ["cookies", "nativeMessaging", "alarms"],
  "host_permissions": ["*://*.google.com/*"],
  "background": { "service_worker": "background.js" },
  "key": ""
}
